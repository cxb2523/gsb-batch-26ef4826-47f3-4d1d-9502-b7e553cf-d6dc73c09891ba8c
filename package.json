{
  "name": "bhop-chronicles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A browser bunny-hop game with honest Source-style air acceleration, a fixed 128 Hz simulation and a playable course.",
  "main": "./src/game/loop.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.ts\"",
    "build": "node tools/build-site.mjs",
    "serve": "node tools/build-site.mjs && node tools/serve.mjs 8080",
    "acceptance": "node tools/build-site.mjs && node tools/acceptance.mjs",
    "verify": "node tools/build-site.mjs && node --test \"tests/*.test.ts\" && node tools/acceptance.mjs"
  }
}
